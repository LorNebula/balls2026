Screen {
    background: #0a1628;
}

#title_bar, #footer_bar {
    height: 1;
    background: #132238;
    color: #e8b84a;
    padding: 0 0;
}

#playfield {
    height: 1fr;
    width: 1fr;
    background: #050d18;
    padding: 0 0;
}

#status_line {
    height: 1;
    background: #1a3050;
    color: #c9d6e3;
    padding: 0 0;
}

#cmd_row {
    height: 1;
    background: #1a3050;
}

#cmd_prefix {
    width: 2;
    height: 1;
    color: #e8b84a;
    background: #1a3050;
}

#cmd_input {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0 0;
    background: #1a3050;
    color: #ffffff;
}

#cmd_input:focus {
    border: none;
    background: #243850;
    background-tint: transparent;
    color: #ffffff;
}

#cmd_input > .input--cursor {
    background: #e8b84a;
    color: #0a1628;
}

#cmd_input > .input--placeholder {
    color: #6a8aaa;
}

#cmd_input > .input--suggestion {
    color: #6a8aaa;
}

#cmd_completions {
    height: 1;
    color: #8aa4be;
    background: #132238;
}

ShipScreen {
    align: center middle;
    background: #050d18 80%;
}

#ship_inspect {
    width: 84;
    height: auto;
    max-height: 90%;
    background: #050d18;
    color: #c9d6e3;
    border: none;
    padding: 0 0;
}
